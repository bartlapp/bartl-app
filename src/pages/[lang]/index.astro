---
// SPDX-License-Identifier: Apache-2.0
import Landing from "@/components/Landing.astro";
import { SITE } from "@/data/constants";
import { languages, type Lang } from "@/i18n/ui";
import MainLayout from "@/layouts/MainLayout.astro";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const description =
  lang === "de"
    ? "Bartl verbindet Anwendung, Infrastruktur und Verantwortung für praktisch ausübbare Resilienz und Souveränität. Der gemeinsame Startpfad ist ein technischer Baustein."
    : "Bartl connects application, infrastructure and responsibility for exercisable resilience and sovereignty. Its shared startup path is one technical contribution.";
---

<MainLayout title={SITE.title} lang={lang} description={description}>
  <Landing lang={lang} />
</MainLayout>
