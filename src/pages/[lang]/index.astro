---
// SPDX-License-Identifier: Apache-2.0
import Landing from "@/components/Landing.astro";
import { SITE } from "@/data/constants";
import { languages, type Lang } from "@/i18n/ui";
import MainLayout from "@/layouts/MainLayout.astro";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const description =
  lang === "de"
    ? "Eine Betriebsphilosophie für nutzbare Services und echte Wahlmöglichkeiten. Bartl verbindet Anwendungsverfahren, Infrastruktur und Verantwortung."
    : "An operating philosophy for usable services and real alternatives. Bartl connects application procedures, infrastructure and responsibility.";
---

<MainLayout title={SITE.title} lang={lang} description={description}>
  <Landing lang={lang} />
</MainLayout>
