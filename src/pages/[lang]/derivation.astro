---
// SPDX-License-Identifier: Apache-2.0
import DocumentArticle from "@/components/DocumentArticle.astro";
import { languages, type Lang } from "@/i18n/ui";
import MainLayout from "@/layouts/MainLayout.astro";
import * as philosophyEn from "../../../docs/philosophy.md";
import * as philosophyDe from "../../../docs/philosophy.de.md";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const document = lang === "de" ? philosophyDe : philosophyEn;
const { Content } = document;
const headings = document.getHeadings();
const title = lang === "de" ? "Ansatz" : "Approach";
const description = lang === "de"
  ? "Wie Anwendung, Infrastruktur und Organisation zusammenwirken müssen, damit Resilienz und Souveränität praktisch nutzbar werden."
  : "How applications, infrastructure and organization must work together to make resilience and sovereignty usable capabilities.";
---

<MainLayout title={title} lang={lang} description={description}>
  <DocumentArticle lang={lang} eyebrow={title} headings={headings}>
    <Content />
    <Fragment slot="after">
      <p>
        <a href={`/${lang}/implement/`}>{lang === "de" ? "Eine Anwendung bartlisieren" : "Bartlize an application"}</a>
        {" · "}
        <a href={`/${lang}/spec/`}>{lang === "de" ? "Anwendungsvertrag" : "Application contract"}</a>
      </p>
    </Fragment>
  </DocumentArticle>
</MainLayout>
