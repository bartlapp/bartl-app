---
// SPDX-License-Identifier: Apache-2.0
import DocumentArticle from "@/components/DocumentArticle.astro";
import InteractivePseudoCode from "@/components/InteractivePseudoCode.astro";
import { languages, type Lang } from "@/i18n/ui";
import MainLayout from "@/layouts/MainLayout.astro";
import * as contractEn from "../../../docs/application-contract.md";
import * as contractDe from "../../../docs/application-contract.de.md";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const document = lang === "de" ? contractDe : contractEn;
const title = lang === "de" ? "Anwendungsvertrag" : "Application contract";
const description = lang === "de"
  ? "Der Bartl-Vertrag für Anwendungen, sichere Service-Recovery und providerunabhängige Ausführung."
  : "The Bartl contract for applications, safe service recovery and provider-independent execution.";

// Render the contract unchanged, replacing only its static algorithm with the
// interactive view of that same source. There is no separate website contract.
const content = await document.compiledContent();
const codeBlock = content.match(/<pre\b[\s\S]*?<\/pre>/);
if (!codeBlock || codeBlock.index === undefined) {
  throw new Error("Contract startup decision code block is missing");
}
const beforeCode = content.slice(0, codeBlock.index);
const afterCode = content.slice(codeBlock.index + codeBlock[0].length);
---

<MainLayout title={title} lang={lang} description={description}>
  <DocumentArticle lang={lang} eyebrow={title} headings={document.getHeadings()}>
    <Fragment set:html={beforeCode} />
    <InteractivePseudoCode lang={lang} />
    <Fragment set:html={afterCode} />
    <Fragment slot="after">
      <p>
        <a href={`/${lang}/derivation/`}>{lang === "de" ? "Betriebsphilosophie" : "Operating philosophy"}</a>
        {" · "}
        <a href={`/${lang}/implement/`}>{lang === "de" ? "Umsetzung" : "Implementation guide"}</a>
      </p>
    </Fragment>
  </DocumentArticle>
</MainLayout>
