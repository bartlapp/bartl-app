---
// SPDX-License-Identifier: Apache-2.0
import type { Lang } from "@/i18n/ui";
import { startupCode } from "@/content/startup-code";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const observations = {
  en: [
    {
      id: "ready",
      label: "Existing local state",
      caption: "Local state exists. Normal native startup uses it; ordinary access opens after native success and readiness.",
    },
    {
      id: "upgrade",
      label: "Supported upgrade",
      caption: "Normal native startup performs the supported migration. The application may run internally; ordinary access remains withheld until success.",
    },
    {
      id: "downgrade",
      label: "Local state, newer version",
      caption: "Native compatibility behavior, or a justified minimal safeguard, rejects the unsupported downgrade without destructive fallback.",
    },
    {
      id: "restore",
      label: "Valid backup",
      caption: "No local state exists. The latest verified backup for this customer and application is restored, then normal native startup runs.",
    },
    {
      id: "initialize",
      label: "No state, no backup",
      caption: "No local state exists, and no backup store is configured or the configured store has no backup. Normal native startup initializes the application.",
    },
    {
      id: "invalid",
      label: "Local observation failure",
      caption: "Local state cannot be observed reliably. Startup stops rather than assuming absence and initializing.",
    },
    {
      id: "backup-error",
      label: "Backup lookup failure",
      caption: "No local state exists, but backup lookup or integrity verification fails. Observation stops startup; it does not fall back to initialization.",
    },
  ],
  de: [
    {
      id: "ready",
      label: "Lokaler Zustand vorhanden",
      caption: "Lokaler Zustand ist vorhanden. Der normale native Start verwendet ihn. Nach nativem Erfolg und Readiness wird der gewöhnliche Zugriff freigegeben.",
    },
    {
      id: "upgrade",
      label: "Unterstütztes Upgrade",
      caption: "Der normale native Start führt die unterstützte Migration durch. Die Anwendung darf intern laufen; gewöhnlicher Zugriff bleibt bis zum Erfolg gesperrt.",
    },
    {
      id: "downgrade",
      label: "Lokaler Zustand, neuere Version",
      caption: "Natives Kompatibilitätsverhalten oder eine begründete minimale Ergänzung weist den unzulässigen Downgrade ohne destruktiven Ersatzpfad ab.",
    },
    {
      id: "restore",
      label: "Gültiger Sicherungsstand",
      caption: "Lokaler Zustand fehlt. Der neueste geprüfte Stand für diesen Kunden und diese Anwendung wird wiederhergestellt. Danach läuft der normale native Start.",
    },
    {
      id: "initialize",
      label: "Kein Zustand, keine Sicherung",
      caption: "Lokaler Zustand fehlt. Kein Backup-Store ist konfiguriert oder der konfigurierte Store enthält keine Sicherung. Der normale native Start initialisiert die Anwendung.",
    },
    {
      id: "invalid",
      label: "Fehler der lokalen Beobachtung",
      caption: "Lokaler Zustand läßt sich nicht zuverlässig beobachten. Der Start stoppt, statt Abwesenheit anzunehmen und zu initialisieren.",
    },
    {
      id: "backup-error",
      label: "Fehler bei der Backup-Abfrage",
      caption: "Lokaler Zustand fehlt, aber Backup-Abfrage oder Integritätsprüfung schlägt fehl. Die Beobachtung stoppt den Start, statt zur Initialisierung überzugehen.",
    },
  ],
} as const;

const labels = {
  en: {
    figure: "Interactive pseudocode for the Bartl startup decision",
    prompt: "Select an observed state to highlight the resulting branch.",
  },
  de: {
    figure: "Interaktiver Pseudocode für die Bartl-Startentscheidung",
    prompt: "Wähle einen beobachteten Zustand, um den daraus folgenden Zweig hervorzuheben.",
  },
} as const;

const scenarios = observations[lang];
const text = labels[lang];
const lines = startupCode;
---

<div class="ipc-container min-w-0">
  <figure>
    <figcaption class="sr-only">{text.figure}</figcaption>
    <div class="border-code-border shadow-base-content/10 overflow-hidden rounded-lg border shadow-lg">
      <pre class="bg-code-background text-code-foreground overflow-x-auto px-4 py-5 font-mono text-xs leading-loose sm:px-6 sm:text-sm"><code>{lines.map((line) => (
          <span class="ipc-line block border-l-2 border-transparent transition-opacity duration-300 motion-reduce:transition-none" data-scenarios={line.scenarios} set:html={line.html + "\n"} />
        ))}</code></pre>
    </div>
  </figure>

  <div class="mt-4 flex flex-wrap gap-2" aria-label={text.prompt}>
    {scenarios.map((scenario) => (
      <button
        type="button"
        class="btn btn-outline btn-sm ipc-btn h-auto min-h-8 whitespace-normal focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-2"
        data-scenario={scenario.id}
        data-caption={scenario.caption}
        aria-pressed="false"
      >
        {scenario.label}
      </button>
    ))}
  </div>

  <p aria-live="polite" class="ipc-caption text-base-content/70 mt-3 min-h-6 text-sm">
    {text.prompt}
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".ipc-container").forEach((container) => {
    const lines = container.querySelectorAll<HTMLSpanElement>(".ipc-line");
    const buttons = container.querySelectorAll<HTMLButtonElement>(".ipc-btn");
    const caption = container.querySelector<HTMLParagraphElement>(".ipc-caption");
    const prompt = caption?.textContent?.trim() || "";
    let activeButton: HTMLButtonElement | null = null;

    const update = () => {
      const active = activeButton?.dataset.scenario;

      lines.forEach((line) => {
        const isActive = !!active && (line.dataset.scenarios || "").split(" ").includes(active);
        line.classList.toggle("ipc-active-border", isActive);
        line.style.opacity = !active || isActive ? "1" : "0.28";
      });

      buttons.forEach((button) => {
        const isActive = button === activeButton;
        button.classList.toggle("btn-active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });

      if (caption) caption.textContent = activeButton?.dataset.caption || prompt;
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        activeButton = activeButton === button ? null : button;
        update();
      });
    });
  });
</script>

<style>
  .ipc-active-border {
    border-color: var(--color-code-keyword);
  }
</style>
