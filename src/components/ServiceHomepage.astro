---
// SPDX-License-Identifier: Apache-2.0
import type { landingCopy } from "@/content/landing";
interface Props {
  copy: typeof landingCopy.en;
}
const { copy: c } = Astro.props;
---

<article class="service-story">
  <header class="hero-section wrap">
    <div class="hero-copy">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title.map((line) => <span>{line}</span>)}</h1>
      <p class="hero-lead">{c.lead}</p>
      <p class="intro">{c.introduction}</p>
      <div class="actions">
        <a class="primary-link" href="#service"
          >{c.storyLink}<span aria-hidden="true">↓</span></a
        >
        <a class="text-link" href="/en/derivation/">{c.approachLink}</a>
      </div>
    </div>
    <figure id="service" class="service-map">
      <figcaption class="eyebrow">{c.service.label}</figcaption>
      <h2>{c.service.title}</h2>
      <div class="person-row">
        <svg
          viewBox="0 0 56 64"
          width="48"
          height="56"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
          ><circle cx="28" cy="14" r="9"></circle><path
            d="M10 58V43a18 18 0 0 1 36 0v15M20 44v14M36 44v14"></path></svg
        >
        <div>
          <p>{c.service.person}</p><span class="outcome"
            >{c.service.outcome}</span
          >
        </div>
      </div>
      <div class="path-label">{c.service.access}</div>
      <div class="provider-frame">
        <p class="frame-label">{c.service.provider}</p>
        <div class="application-node">
          <span class="node-mark" aria-hidden="true"
            ><svg
              viewBox="0 0 24 24"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><path d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6M9 16h6"></path></svg
            ></span
          ><div>
            <h3>{c.service.application}</h3><p>{c.service.applicationDetail}</p>
          </div>
        </div>
        <div class="state-node">
          <p>{c.service.state}</p><small>{c.service.stateDetail}</small>
        </div>
      </div>
      <div class="connection" aria-hidden="true"></div>
      <div class="dependency-node">
        <h3>{c.service.dependencies}</h3><p>{c.service.dependenciesDetail}</p>
      </div>
      <p class="figure-note">{c.service.caption}</p>
    </figure>
  </header>

  <section
    class="maintenance section-band"
    aria-labelledby="maintenance-heading"
  >
    <div class="wrap section-inner">
      <div class="section-heading">
        <p class="eyebrow">{c.maintenance.label}</p><h2
          id="maintenance-heading"
        >
          {c.maintenance.title}
        </h2><p class="section-lead">{c.maintenance.lead}</p>
      </div>
      <div class="replacement-track">
        <div class="track-end source-end">
          <span class="node-mark" aria-hidden="true"
            ><svg
              viewBox="0 0 24 24"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><path d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6M9 16h6"></path></svg
            ></span
          ><div>
            <h3>{c.maintenance.source}</h3><p>{c.maintenance.sourceDetail}</p>
          </div>
        </div>
        <ol class="recovery-steps">
          {
            c.maintenance.steps.map((step, index) => (
              <li>
                <>
                  <span class="step-number" aria-hidden="true">
                    {index + 1}
                  </span>
                  <div>
                    <>
                      <h3>{step.title}</h3>
                      <p>{step.detail}</p>
                      <span class="owner">{step.owner}</span>
                    </>
                  </div>
                </>
              </li>
            ))
          }
        </ol>
        <div class="track-end target-end">
          <span class="node-mark" aria-hidden="true"
            ><svg
              viewBox="0 0 24 24"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><path d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6M9 16h6"></path></svg
            ></span
          ><div>
            <h3>{c.maintenance.target}</h3><p>{c.maintenance.targetDetail}</p>
          </div><span class="authority-mark" aria-hidden="true">✓</span>
        </div>
      </div>
      <div class="maintenance-notes">
        <p class="condition">{c.maintenance.condition}</p><p>
          {c.maintenance.cost}
        </p>
      </div>
    </div>
  </section>

  <section class="wrap section-inner" aria-labelledby="loss-heading">
    <div class="section-heading">
      <p class="eyebrow">{c.loss.label}</p><h2 id="loss-heading">
        {c.loss.title}
      </h2><p class="section-lead">{c.loss.lead}</p>
    </div>
    <figure class="loss-map">
      <div class="lost-provider">
        <span class="lost-symbol" aria-hidden="true">×</span><div>
          <h3>{c.loss.source}</h3><p>{c.loss.sourceDetail}</p>
        </div><span class="lost-application" aria-hidden="true"
          >{c.loss.sourceApplication}</span
        >
      </div>
      <div class="recovery-route">
        <div class="independent-inputs">
          <h3 class="eyebrow">{c.loss.outside}</h3><ul>
            {
              c.loss.inputs.map((input, index) => (
                <li>
                  <>
                    <span class="input-number" aria-hidden="true">
                      0{index + 1}
                    </span>
                    <div>
                      <>
                        <h4>{input.title}</h4>
                        <p>{input.detail}</p>
                      </>
                    </div>
                  </>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="destination">
          <p class="frame-label">{c.loss.target}</p><p
            class="destination-capacity"
          >
            {c.loss.targetDetail}
          </p>
          <div class="application-node">
            <span class="node-mark" aria-hidden="true"
              ><svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                ><path d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6M9 16h6"></path></svg
              ></span
            ><h3>
              {c.loss.targetApplication}
            </h3>
          </div>
          <div class="state-node">
            <p>{c.service.state}</p><small>{c.service.stateDetail}</small>
          </div>
          <div class="connection" aria-hidden="true"></div>
          <p class="dependency-node">{c.loss.targetDependencies}</p>
          <div class="result">
            <svg
              viewBox="0 0 56 64"
              width="34"
              height="40"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><circle cx="28" cy="14" r="9"></circle><path
                d="M10 58V43a18 18 0 0 1 36 0v15"></path></svg
            ><p>{c.loss.result}</p>
          </div>
        </div>
      </div>
      <p class="authority-boundary">{c.loss.boundary}</p>
      <figcaption class="figure-note">{c.loss.caption}</figcaption>
    </figure>
  </section>

  <section
    class="evidence-section section-band"
    aria-labelledby="evidence-heading"
  >
    <div class="wrap section-inner evidence-layout">
      <div class="evidence-intro">
        <p class="eyebrow">{c.evidence.label}</p><h2 id="evidence-heading">
          {c.evidence.title}
        </h2><p class="section-lead">{c.evidence.lead}</p><a
          class="text-link"
          href="/en/implement/#worked-example-keycloak"
          >{c.evidence.link}<span aria-hidden="true"> ↗</span></a
        >
      </div>
      <div class="evidence-record">
        <div class="record-heading">
          <span class="node-mark" aria-hidden="true">K</span><div>
            <h3>{c.evidence.package}</h3><p>{c.evidence.version}</p>
          </div>
        </div><div class="qualification">
          <h4>{c.evidence.exercised}</h4><ul>
            {
              c.evidence.cases.map((item) => (
                <li>
                  <span aria-hidden="true">✓</span>
                  {item}
                </li>
              ))
            }
          </ul><p>{c.evidence.failure}</p>
        </div><div class="remaining">
          <h4>{c.evidence.remaining}</h4><p>{c.evidence.remainingDetail}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap closing">
    <h2>{c.closing.title}</h2><p>{c.closing.detail}</p><div class="actions">
      <a class="primary-link" href="/en/derivation/">{c.closing.approach}</a><a
        class="text-link"
        href="/en/implement/">{c.closing.implement}</a
      ><a class="text-link" href="/en/spec/">{c.closing.contract}</a>
    </div>
  </section>
</article>

<style>
  .service-story {
    --ink: var(--color-base-content);
    --accent: light-dark(#35666d, #9cc2c4);
    --line: color-mix(in oklab, var(--ink) 23%, transparent);
    --wash: color-mix(in oklab, var(--accent) 7%, var(--color-base-100));
    --muted: color-mix(in oklab, var(--ink) 76%, var(--color-base-100));
    color: var(--ink);
  }
  :global([data-theme="dark"]) .service-story {
    --accent: #9cc2c4;
  }
  .wrap {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 40px;
  }
  .eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    line-height: 1.6;
  }
  h1 {
    font-size: clamp(3rem, 4.6vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.055em;
    font-weight: 500;
  }
  h1 span {
    display: block;
  }
  h1 span:last-child {
    color: var(--accent);
  }
  h2 {
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    line-height: 1.12;
    letter-spacing: -0.04em;
    font-weight: 500;
    text-wrap: balance;
  }
  h3,
  h4 {
    font-weight: 600;
    line-height: 1.35;
  }
  p {
    line-height: 1.6;
  }
  .hero-section {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 64px;
    padding-block: 76px 88px;
    align-items: center;
  }
  .hero-copy > .eyebrow {
    margin-bottom: 28px;
  }
  .hero-lead {
    font-size: 1.3rem;
    margin-top: 30px;
    max-width: 30rem;
    line-height: 1.5;
  }
  .intro {
    margin-top: 20px;
    color: var(--muted);
    max-width: 29rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    align-items: center;
    margin-top: 30px;
  }
  a {
    text-underline-offset: 5px;
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .primary-link {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding: 14px 20px;
    background: var(--accent);
    color: var(--color-base-100);
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .text-link {
    color: var(--accent);
    text-decoration: underline;
    font-size: 0.9rem;
  }
  .service-map {
    background: var(--wash);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 28px;
    scroll-margin-top: 30px;
  }
  .service-map h2 {
    font-size: 1.55rem;
    margin-top: 10px;
    max-width: 22rem;
    letter-spacing: -0.025em;
  }
  .person-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding-top: 24px;
    font-size: 0.85rem;
  }
  .person-row svg {
    color: var(--accent);
    flex-shrink: 0;
  }
  .outcome {
    font-weight: 600;
  }
  .path-label {
    position: relative;
    text-align: center;
    margin-block: 16px;
    padding-block: 10px;
    font-size: 0.7rem;
    color: var(--muted);
  }
  .path-label::before,
  .path-label::after {
    content: "";
    position: absolute;
    height: 12px;
    width: 1px;
    background: var(--accent);
    left: 50%;
  }
  .path-label::before {
    top: -10px;
  }
  .path-label::after {
    bottom: -12px;
  }
  .provider-frame {
    padding: 16px;
    border: 1px dashed var(--accent);
    border-radius: 5px;
  }
  .frame-label {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .application-node {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px;
    background: var(--accent);
    color: var(--color-base-100);
    border-radius: 4px;
  }
  .application-node h3 {
    font-size: 1rem;
  }
  .application-node p {
    font-size: 0.75rem;
  }
  .node-mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border: 1px solid currentColor;
    border-radius: 8px;
    font-size: 1.25rem;
    font-weight: 500;
  }
  .state-node {
    border: 1px solid var(--line);
    border-top: 0;
    margin: 0 10px;
    padding: 10px;
    text-align: center;
    border-radius: 0 0 12px 12px;
    font-size: 0.8rem;
    background: var(--color-base-100);
  }
  .state-node small {
    font-size: 0.65rem;
    color: var(--muted);
  }
  .connection {
    width: 1px;
    height: 22px;
    background: var(--accent);
    margin-inline: auto;
  }
  .dependency-node {
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 4px;
    text-align: center;
    font-size: 0.85rem;
  }
  .dependency-node h3 {
    font-size: 0.85rem;
  }
  .dependency-node p {
    font-size: 0.7rem;
    margin-top: 3px;
    color: var(--muted);
  }
  .figure-note {
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 20px;
  }
  .section-band {
    background: var(--wash);
    border-block: 1px solid var(--line);
  }
  .section-inner {
    padding-block: 76px;
  }
  .section-heading {
    max-width: 730px;
  }
  .section-heading h2,
  .evidence-intro h2 {
    margin-top: 16px;
  }
  .section-lead {
    font-size: 1.05rem;
    color: var(--muted);
    margin-top: 22px;
    max-width: 40rem;
  }
  .replacement-track {
    margin-top: 44px;
  }
  .track-end {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--color-base-100);
  }
  .track-end h3 {
    font-size: 0.95rem;
  }
  .track-end p {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .source-end {
    max-width: 520px;
  }
  .recovery-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding-block: 34px;
    margin-inline: 22px;
    list-style: none;
  }
  .recovery-steps li {
    position: relative;
    padding-right: 24px;
  }
  .recovery-steps li::before {
    content: "";
    height: 1px;
    background: var(--accent);
    position: absolute;
    top: 17px;
    left: 0;
    right: 0;
  }
  .recovery-steps li:last-child::before {
    right: auto;
    width: 34px;
  }
  .step-number {
    position: relative;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--color-base-100);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    font-size: 0.8rem;
    margin-bottom: 18px;
  }
  .recovery-steps h3 {
    font-size: 1.15rem;
  }
  .recovery-steps p {
    font-size: 0.85rem;
    margin-top: 10px;
  }
  .owner {
    display: block;
    font-size: 0.65rem;
    color: var(--accent);
    margin-top: 14px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .target-end {
    margin-left: auto;
    max-width: 580px;
    border-color: var(--accent);
  }
  .target-end .node-mark,
  .authority-mark {
    color: var(--accent);
  }
  .authority-mark {
    margin-left: auto;
    font-size: 1.4rem;
  }
  .maintenance-notes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 32px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .condition {
    border-left: 3px solid var(--accent);
    padding-left: 18px;
  }
  .loss-map {
    margin-top: 40px;
  }
  .lost-provider {
    display: flex;
    align-items: center;
    gap: 20px;
    border: 1px dashed var(--line);
    padding: 20px 24px;
    border-radius: 4px;
    color: var(--muted);
  }
  .lost-provider h3 {
    text-decoration: line-through;
  }
  .lost-provider p {
    font-size: 0.85rem;
  }
  .lost-symbol {
    font-size: 2.8rem;
    line-height: 1;
    font-weight: 300;
  }
  .lost-application {
    margin-left: auto;
    text-decoration: line-through;
    font-size: 0.9rem;
  }
  .recovery-route {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 60px;
    margin-top: 30px;
    align-items: center;
  }
  .independent-inputs ul {
    list-style: none;
    margin-top: 12px;
  }
  .independent-inputs li {
    display: flex;
    gap: 18px;
    border-top: 1px solid var(--line);
    padding-block: 18px;
  }
  .input-number {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.75rem;
    padding-top: 3px;
  }
  .independent-inputs h4 {
    font-size: 0.95rem;
  }
  .independent-inputs p {
    font-size: 0.85rem;
    margin-top: 6px;
    color: var(--muted);
  }
  .destination {
    position: relative;
    border: 1px solid var(--accent);
    border-radius: 5px;
    padding: 24px;
    background: var(--wash);
  }
  .destination::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -46px;
    width: 30px;
    height: 10px;
    border-top: 1px solid var(--accent);
    border-right: 1px solid var(--accent);
    transform: skewY(18deg);
  }
  .destination .frame-label {
    margin-bottom: 0;
  }
  .destination-capacity {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .destination .application-node h3 {
    font-size: 0.9rem;
  }
  .result {
    display: flex;
    align-items: center;
    gap: 14px;
    border-top: 1px solid var(--line);
    margin-top: 20px;
    padding-top: 16px;
    font-size: 0.9rem;
    color: var(--accent);
  }
  .result svg {
    flex-shrink: 0;
  }
  .authority-boundary {
    border-left: 3px solid var(--accent);
    padding: 8px 0 8px 20px;
    margin-top: 26px;
    font-size: 0.9rem;
    max-width: 900px;
  }
  .evidence-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .evidence-intro .text-link {
    display: inline-block;
    margin-top: 28px;
  }
  .evidence-record {
    background: var(--color-base-100);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .record-heading {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px;
    border-bottom: 1px solid var(--line);
  }
  .record-heading .node-mark {
    color: var(--accent);
  }
  .record-heading h3 {
    font-size: 1.35rem;
  }
  .record-heading p {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .qualification,
  .remaining {
    padding: 24px;
  }
  .qualification h4,
  .remaining h4 {
    font-size: 0.85rem;
  }
  .qualification ul {
    list-style: none;
    margin-block: 16px;
  }
  .qualification li {
    display: flex;
    gap: 12px;
    font-size: 0.9rem;
    margin-top: 10px;
  }
  .qualification li span {
    color: var(--accent);
  }
  .qualification p,
  .remaining p {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .remaining {
    border-top: 1px dashed var(--line);
  }
  .remaining p {
    margin-top: 10px;
  }
  .closing {
    padding-block: 80px;
  }
  .closing h2 {
    max-width: 680px;
  }
  .closing > p {
    max-width: 660px;
    margin-top: 24px;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .hero-section {
      gap: 32px;
    }
    h1 {
      font-size: 3.2rem;
    }
    .wrap {
      padding-inline: 28px;
    }
    .service-map {
      padding: 22px;
    }
    .evidence-layout {
      gap: 40px;
    }
  }
  @media (max-width: 720px) {
    .wrap {
      padding-inline: 22px;
    }
    .hero-section {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-block: 44px;
    }
    h1 {
      font-size: clamp(2.6rem, 8.8vw, 3.6rem);
    }
    .hero-copy > .eyebrow {
      margin-bottom: 22px;
    }
    .hero-lead {
      font-size: 1.15rem;
      margin-top: 24px;
    }
    .intro {
      font-size: 0.95rem;
    }
    .service-map {
      padding: 22px;
