---
// SPDX-License-Identifier: Apache-2.0
import type { landingCopy } from "@/content/landing";
import type { Lang } from "@/i18n/ui";
import ServicePicture from "./ServicePicture.astro";
interface Props {
  copy: (typeof landingCopy)[Lang];
  lang: Lang;
}
const { copy: c, lang } = Astro.props;
---

<article class="service-story">
  <header class="hero-section wrap">
    <div class="hero-copy">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title.map((line) => <span>{line}</span>)}</h1>
      <p class="hero-lead">{c.lead}</p>
      <p class="intro">{c.introduction}</p>
      <div class="actions">
        <a class="primary-link" href="#service"
          >{c.storyLink}<span aria-hidden="true">↓</span></a
        >
        <a class="text-link" href={`/${lang}/derivation/`}>{c.approachLink}</a>
      </div>
    </div>
    <figure id="service" class="service-map">
      <figcaption class="eyebrow">{c.service.label}</figcaption>
      <h2>{c.service.title}</h2>
      <ServicePicture kind="hero" copy={c} />
      <p class="figure-note">{c.service.caption}</p>
    </figure>
  </header>

  <section
    class="maintenance section-band"
    aria-labelledby="maintenance-heading"
  >
    <div class="wrap section-inner">
      <div class="section-heading">
        <p class="eyebrow">{c.maintenance.label}</p><h2
          id="maintenance-heading"
        >
          {c.maintenance.title}
        </h2><p class="section-lead">{c.maintenance.lead}</p>
      </div>
      <div class="picture-block"><ServicePicture kind="recovery" copy={c} /></div>
      <p class="maintenance-cost">{c.maintenance.cost}</p>
    </div>
  </section>

  <section class="wrap section-inner" aria-labelledby="loss-heading">
    <div class="section-heading">
      <p class="eyebrow">{c.loss.label}</p><h2 id="loss-heading">
        {c.loss.title}
      </h2><p class="section-lead">{c.loss.lead}</p>
    </div>
    <figure class="loss-map">
      <ServicePicture kind="loss" copy={c} />
      <figcaption class="figure-note">{c.loss.caption}</figcaption>
    </figure>
  </section>

  <section
    class="evidence-section section-band"
    aria-labelledby="evidence-heading"
  >
    <div class="wrap section-inner evidence-layout">
      <div class="evidence-intro">
        <p class="eyebrow">{c.evidence.label}</p><h2 id="evidence-heading">
          {c.evidence.title}
        </h2><p class="section-lead">{c.evidence.lead}</p><a
          class="text-link"
          href={`/${lang}/implement/#${lang === "de" ? "beispiel-keycloak" : "worked-example-keycloak"}`}
          >{c.evidence.link}<span aria-hidden="true"> ↗</span></a
        >
      </div>
      <div class="evidence-record">
        <div class="record-heading">
          <span class="node-mark" aria-hidden="true">K</span><div>
            <h3>{c.evidence.package}</h3><p>{c.evidence.version}</p>
          </div>
        </div><div class="qualification">
          <h4>{c.evidence.exercised}</h4><ul>
            {
              c.evidence.cases.map((item) => (
                <li>
                  <span aria-hidden="true">✓</span>
                  {item}
                </li>
              ))
            }
          </ul><p>{c.evidence.failure}</p>
        </div><div class="remaining">
          <h4>{c.evidence.remaining}</h4><p>{c.evidence.remainingDetail}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap closing">
    <h2>{c.closing.title}</h2><p>{c.closing.detail}</p><div class="actions">
      <a class="primary-link" href={`/${lang}/derivation/`}>{c.closing.approach}</a><a
        class="text-link"
        href={`/${lang}/implement/`}>{c.closing.implement}</a
      ><a class="text-link" href={`/${lang}/spec/`}>{c.closing.contract}</a>
    </div>
  </section>
</article>

<style>
  .service-story {
    --ink: var(--color-base-content);
    --accent: light-dark(#35666d, #9cc2c4);
    --line: color-mix(in oklab, var(--ink) 23%, transparent);
    --wash: color-mix(in oklab, var(--accent) 7%, var(--color-base-100));
    --muted: color-mix(in oklab, var(--ink) 76%, var(--color-base-100));
    color: var(--ink);
    overflow-wrap: anywhere;
    hyphens: auto;
  }
  :global([data-theme="dark"]) .service-story {
    --accent: #9cc2c4;
  }
  .wrap {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 40px;
  }
  .eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    line-height: 1.6;
  }
  h1 {
    font-size: clamp(3rem, 4.6vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.055em;
    font-weight: 500;
  }
  h1 span {
    display: block;
  }
  h1 span:last-child {
    color: var(--accent);
  }
  h2 {
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    line-height: 1.12;
    letter-spacing: -0.04em;
    font-weight: 500;
    text-wrap: balance;
  }
  h3,
  h4 {
    font-weight: 600;
    line-height: 1.35;
  }
  p {
    line-height: 1.6;
  }
  .hero-section {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 64px;
    padding-block: 76px 88px;
    align-items: center;
  }
  .hero-copy > .eyebrow {
    margin-bottom: 28px;
  }
  .hero-lead {
    font-size: 1.3rem;
    margin-top: 30px;
    max-width: 30rem;
    line-height: 1.5;
  }
  .intro {
    margin-top: 20px;
    color: var(--muted);
    max-width: 29rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    align-items: center;
    margin-top: 30px;
  }
  a {
    text-underline-offset: 5px;
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .primary-link {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding: 14px 20px;
    background: var(--accent);
    color: var(--color-base-100);
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .text-link {
    color: var(--accent);
    text-decoration: underline;
    font-size: 0.9rem;
  }
  .service-map {
    background: var(--wash);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 28px;
    scroll-margin-top: 30px;
  }
  .service-map h2 {
    font-size: 1.55rem;
    margin-top: 10px;
    max-width: 22rem;
    letter-spacing: -0.025em;
  }
  .node-mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border: 1px solid currentColor;
    border-radius: 8px;
    font-size: 1.25rem;
    font-weight: 500;
  }
  .figure-note {
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 20px;
  }
  .section-band {
    background: var(--wash);
    border-block: 1px solid var(--line);
  }
  .section-inner {
    padding-block: 76px;
  }
  .section-heading {
    max-width: 730px;
  }
  .section-heading h2,
  .evidence-intro h2 {
    margin-top: 16px;
  }
  .section-lead {
    font-size: 1.05rem;
    color: var(--muted);
    margin-top: 22px;
    max-width: 40rem;
  }
  .picture-block,
  .loss-map {
    margin-top: 40px;
  }
  .maintenance-cost {
    margin-top: 24px;
    max-width: 800px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .evidence-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .evidence-intro .text-link {
    display: inline-block;
    margin-top: 28px;
  }
  .evidence-record {
    background: var(--color-base-100);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .record-heading {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px;
    border-bottom: 1px solid var(--line);
  }
  .record-heading .node-mark {
    color: var(--accent);
  }
  .record-heading h3 {
    font-size: 1.35rem;
  }
  .record-heading p {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .qualification,
  .remaining {
    padding: 24px;
  }
  .qualification h4,
  .remaining h4 {
    font-size: 0.85rem;
  }
  .qualification ul {
    list-style: none;
    margin-block: 16px;
  }
  .qualification li {
    display: flex;
    gap: 12px;
    font-size: 0.9rem;
    margin-top: 10px;
  }
  .qualification li span {
    color: var(--accent);
  }
  .qualification p,
  .remaining p {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .remaining {
    border-top: 1px dashed var(--line);
  }
  .remaining p {
    margin-top: 10px;
  }
  .closing {
    padding-block: 80px;
  }
  .closing h2 {
    max-width: 680px;
  }
  .closing > p {
    max-width: 660px;
    margin-top: 24px;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .hero-section {
      gap: 32px;
    }
    h1 {
      font-size: 3.2rem;
    }
    .wrap {
      padding-inline: 28px;
    }
    .service-map {
      padding: 22px;
    }
    .evidence-layout {
      gap: 40px;
    }
  }
  @media (max-width: 720px) {
    .wrap {
      padding-inline: 22px;
    }
    .hero-section {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-block: 44px;
    }
    h1 {
      font-size: clamp(2.6rem, 8.8vw, 3.6rem);
    }
    .hero-copy > .eyebrow {
      margin-bottom: 22px;
    }
    .hero-lead {
      font-size: 1.15rem;
      margin-top: 24px;
    }
    .intro {
      font-size: 0.95rem;
    }
    .service-map {
      padding: 22px;
    }
    .section-inner {
      padding-block: 48px;
    }
    .section-lead {
      font-size: 1rem;
    }
    .evidence-layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .closing {
      padding-block: 48px;
    }
    .actions {
      gap: 20px;
    }
    .figure-note {
      font-size: 0.75rem;
    }
  }
</style>
