---
// SPDX-License-Identifier: Apache-2.0
import type { landingCopy } from "@/content/landing";
import type { Lang } from "@/i18n/ui";
import ServicePicture from "./ServicePicture.astro";
import RequirementsPicture from "./RequirementsPicture.astro";
interface Props { copy: (typeof landingCopy)[Lang]; lang: Lang }
const { copy: c, lang } = Astro.props;
const chapters = [
  { kind: "service" as const, ...c.problem },
  { kind: "choice" as const, ...c.choice },
  { kind: "capability" as const, ...c.capability },
  { kind: "upkeep" as const, ...c.upkeep },
];
---

<article class="service-story">
  <header class="wrap intro-header">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1>{c.title}</h1>
    <p class="hero-lead">{c.lead}</p>
  </header>

  <div id="service" class="visual-argument wrap">
    {chapters.map((chapter, index) => <section class:list={["chapter", { reverse: index % 2 === 1 }]} aria-labelledby={`${chapter.kind}-heading`}>
      <div class="chapter-heading">
        <p class="eyebrow">{chapter.label}</p>
        <h2 id={`${chapter.kind}-heading`}>{chapter.title}</h2>
      </div>
      <figure class="chapter-picture">
        <RequirementsPicture kind={chapter.kind} lang={lang}/>
        {index === 0 && <figcaption>{c.service.caption}</figcaption>}
      </figure>
      <div class="chapter-prose">
        <p class="premise">{chapter.lead}</p>
        <p>{chapter.consequence}</p>
      </div>
    </section>)}
  </div>

  <section class="operating-model section-band" aria-labelledby="contributions-heading">
    <div class="wrap section-inner">
      <div class="model-heading">
        <div><p class="eyebrow">{c.contributions.label}</p><h2 id="contributions-heading">{c.contributions.title}</h2><p class="section-lead">{c.requirements.conclusion}</p></div>
        <RequirementsPicture kind="model" lang={lang}/>
      </div>
      <div class="contribution-list">
        {c.contributions.items.map((item, index) => <section class="contribution">
          <div class="contribution-title"><span class="number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3></div>
          <p class="gap">{item.gap}</p><p class="action">{item.action}</p>
        </section>)}
      </div>
      <div class="model-limits"><p>{c.contributions.result}</p><p>{c.requirements.boundary}</p></div>
    </div>
  </section>

  <section class="wrap section-inner" aria-labelledby="demonstration-heading">
    <div class="section-heading">
      <p class="eyebrow">{c.demonstration.label}</p>
      <h2 id="demonstration-heading">{c.demonstration.title}</h2>
      <p class="section-lead">{c.demonstration.lead}</p>
    </div>
    <div class="example-summary"><p>{c.demonstration.recoverySummary}</p><p>{c.demonstration.lossSummary}</p></div>
    <p class="consequence">{c.demonstration.lesson}</p>
    <details>
      <summary>{c.maintenance.title}</summary>
      <div class="detail-body"><p class="detail-intro">{c.maintenance.lead}</p><ServicePicture kind="recovery" copy={c}/><p class="detail-note">{c.maintenance.cost}</p></div>
    </details>
    <details>
      <summary>{c.loss.title}</summary>
      <div class="detail-body"><p class="detail-intro">{c.loss.lead}</p><ServicePicture kind="loss" copy={c}/><p class="detail-note">{c.loss.caption}</p></div>
    </details>
  </section>

  <section class="section-band" aria-labelledby="evidence-heading">
    <div class="wrap section-inner evidence-layout">
      <div>
        <p class="eyebrow">{c.evidence.label}</p><h2 id="evidence-heading">{c.evidence.title}</h2>
        <p class="section-lead">{c.evidence.lead}</p>
        <a class="text-link" href={`/${lang}/implement/#${lang === "de" ? "beispiel-keycloak" : "worked-example-keycloak"}`}>{c.evidence.link}</a>
      </div>
      <div class="evidence-record"><h3>{c.evidence.package}</h3><p class="version">{c.evidence.version}</p><ul>{c.evidence.cases.map(item => <li>{item}</li>)}</ul><p>{c.evidence.remainingDetail}</p></div>
    </div>
  </section>

  <footer class="closing wrap section-inner">
    <h2>{c.closing.title}</h2><p class="section-lead">{c.closing.detail}</p>
    <nav class="actions" aria-label={c.approachLink}>
      <a class="primary-link" href={`/${lang}/derivation/`}>{c.closing.approach}</a>
      <a class="text-link" href={`/${lang}/implement/`}>{c.closing.implement}</a>
      <a class="text-link" href={`/${lang}/spec/`}>{c.closing.contract}</a>
    </nav>
  </footer>
</article>

<style>
  .service-story {
    --ink: var(--color-base-content);
    --accent: light-dark(#35666d, #9cc2c4);
    --warning: light-dark(#a55c43, #e5a58b);
    --line: color-mix(in oklab, var(--ink) 28%, transparent);
    --wash: color-mix(in oklab, var(--accent) 7%, var(--color-base-100));
    --muted: color-mix(in oklab, var(--ink) 78%, var(--color-base-100));
    color: var(--ink); overflow-wrap: anywhere; hyphens: auto;
  }
  :global([data-theme="dark"]) .service-story { --accent: #9cc2c4; --warning: #e5a58b; }
  .wrap { max-width: 1200px; margin-inline: auto; padding-inline: 40px; }
  .intro-header { padding-block: 60px 48px; }
  .eyebrow { font-size: .72rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); line-height: 1.6; margin-bottom: 16px; }
  h1 { max-width: 1040px; font-size: clamp(2.25rem, 4.2vw, 3.8rem); line-height: 1.12; letter-spacing: -.04em; font-weight: 500; text-wrap: balance; }
  h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1.15; letter-spacing: -.035em; font-weight: 500; text-wrap: balance; }
  h3 { font-size: 1.15rem; line-height: 1.35; font-weight: 600; }
  h1, h2 { hyphens: none; }
  p { line-height: 1.65; }
  .hero-lead { max-width: 800px; margin-top: 24px; font-size: 1.2rem; line-height: 1.6; color: var(--muted); }
  .chapter { display: grid; grid-template-columns: 1.15fr 1fr; column-gap: 64px; padding-block: 44px 56px; border-top: 1px solid var(--line); align-items: center; }
  .chapter-heading { grid-column: 1 / -1; max-width: 750px; margin-bottom: 24px; }
  .chapter-picture { align-self: center; min-width: 0; padding-block: 12px; }
  .chapter-prose { max-width: 32rem; }
  .chapter-prose p + p { margin-top: 20px; }
  .premise { font-size: 1.12rem; }
  .chapter-prose p:last-child { color: var(--muted); }
  .reverse .chapter-picture { grid-column: 2; grid-row: 2; }
  .reverse .chapter-prose { grid-column: 1; grid-row: 2; }
  figcaption { margin-top: 10px; font-size: .74rem; line-height: 1.6; color: var(--muted); text-align: center; }
  .section-inner { padding-block: 72px; }
  .section-band { background: var(--wash); border-block: 1px solid var(--line); }
  .section-heading { max-width: 800px; }
  .section-lead { font-size: 1.08rem; color: var(--muted); margin-top: 24px; max-width: 46rem; }
  .consequence { margin-top: 30px; max-width: 52rem; border-left: 3px solid var(--accent); padding-left: 22px; }
  .model-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: end; }
  .model-heading .section-lead { margin: 0; }
  .contribution-list { margin-top: 40px; }
  .contribution { display: grid; grid-template-columns: .8fr 1fr 1.6fr; gap: 32px; padding-block: 24px; border-top: 1px solid var(--line); align-items: start; }
  .contribution-title { display: flex; gap: 16px; align-items: baseline; }
  .number { color: var(--accent); font-size: .8rem; font-variant-numeric: tabular-nums; }
  .gap { color: var(--muted); }
  .model-limits { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; border-top: 1px solid var(--line); padding-top: 28px; font-size: .95rem; }
  .model-limits p:last-child { color: var(--muted); }
  .example-summary { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-top: 32px; }
  details { border-top: 1px solid var(--line); margin-top: 28px; }
  summary { padding-block: 22px; cursor: pointer; font-size: 1.15rem; font-weight: 500; color: var(--accent); }
  summary:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
  .detail-body { padding-block: 8px 24px; }
  .detail-intro { max-width: 44rem; margin-bottom: 28px; }
  .detail-note { font-size: .88rem; color: var(--muted); margin-top: 24px; max-width: 56rem; }
  .evidence-layout { display: grid; grid-template-columns: 1.2fr 1fr; gap: 72px; }
  .evidence-record { border-left: 1px solid var(--line); padding-left: 32px; }
  .version { font-size: .85rem; color: var(--muted); margin-top: 6px; }
  .evidence-record ul { list-style: disc; padding-left: 20px; margin-block: 24px; }
  .evidence-record li { margin-block: 8px; }
  .evidence-record > p:last-child { font-size: .85rem; color: var(--muted); }
  a { text-underline-offset: 5px; }
  .text-link { display: inline-block; color: var(--accent); text-decoration: underline; margin-top: 22px; }
  .actions { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; margin-top: 30px; }
  .actions .text-link { margin-top: 0; }
  .primary-link { padding: 14px 20px; background: var(--accent); color: var(--color-base-100); border-radius: 4px; font-weight: 600; }
  @media (max-width: 900px) {
    .chapter, .model-heading, .model-limits, .evidence-layout { gap: 32px; }
    .contribution { grid-template-columns: 1fr 1.5fr; gap: 16px 32px; }
    .contribution-title { grid-column: 1 / -1; }
  }
  @media (max-width: 680px) {
    .wrap { padding-inline: 24px; }
    .intro-header { padding-block: 40px 32px; }
    .hero-lead { font-size: 1.1rem; }
    .chapter { grid-template-columns: 1fr; gap: 0; padding-block: 32px 40px; }
    .chapter-heading { grid-column: auto; margin-bottom: 12px; }
    .chapter-picture, .reverse .chapter-picture { grid-column: 1; grid-row: 2; padding-block: 4px 24px; }
    .chapter-prose, .reverse .chapter-prose { grid-column: 1; grid-row: 3; }
    .chapter-prose p + p { margin-top: 16px; }
    .premise { font-size: 1.05rem; }
    .section-inner { padding-block: 48px; }
    .model-heading, .contribution, .model-limits, .example-summary, .evidence-layout { grid-template-columns: 1fr; gap: 24px; }
    .contribution { gap: 12px; }
    .contribution-title { grid-column: auto; }
    .evidence-record { padding-left: 20px; }
  }
  @media (max-width: 360px) { .wrap { padding-inline: 18px; } h1 { font-size: 2rem; } }
</style>
