---
// SPDX-License-Identifier: Apache-2.0
import { PRIMARY_NAVIGATION, SITE } from "@/data/constants";
import { languages, type Lang } from "@/i18n/ui";
import { getAlternatePath, useTranslations } from "@/i18n/utils";

interface Props {
  lang: Lang;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const t = useTranslations(lang);
const homePath = `/${lang}/`;
---

<header class="bg-base-100 border-base-300 sticky top-0 z-50 border-b">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2 sm:min-h-16 sm:flex-nowrap sm:px-6 sm:py-0 lg:px-8">
    <a
      class="focus-visible:outline-primary rounded-sm text-xl font-semibold focus-visible:outline-2 focus-visible:outline-offset-4"
      href={homePath}
      aria-current={pathname === homePath ? "page" : undefined}
    >
      {SITE.title}
    </a>

    <nav aria-label={t("nav.main")} class="order-last flex w-full flex-wrap items-center justify-center gap-1 sm:order-none sm:ml-auto sm:w-auto">
      {PRIMARY_NAVIGATION.map(({ path, label }) => (
        <a
          href={`/${lang}/${path}/`}
          aria-current={pathname === `/${lang}/${path}/` ? "page" : undefined}
          class="btn btn-ghost btn-sm px-2 focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          {t(label)}
        </a>
      ))}
    </nav>

    <nav aria-label={t("nav.secondary")} class="ml-auto flex items-center gap-1 sm:ml-0">
      <a
        href={SITE.codeberg}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost btn-sm gap-2 focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-2"
        aria-label={t("nav.codeberg")}
      >
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
          <path d="M16 18 22 12 16 6"></path>
          <path d="M8 6 2 12 8 18"></path>
          <path d="M14.5 4 9.5 20"></path>
        </svg>
        <span class="hidden sm:inline">Codeberg</span>
      </a>

      <details class="dropdown dropdown-end">
        <summary
          class="btn btn-ghost btn-sm gap-1 focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-2"
          aria-label={t("nav.language")}
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M2 12h20"></path>
            <path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20"></path>
          </svg>
          <span class="hidden sm:inline">{lang.toUpperCase()}</span>
        </summary>
        <ul class="dropdown-content menu bg-base-100 border-base-300 z-10 mt-2 w-40 rounded-box border p-2 shadow-md">
          {Object.entries(languages).map(([code, name]) => (
            <li>
              <a
                href={getAlternatePath(pathname, code as Lang)}
                aria-current={code === lang ? "page" : undefined}
                class:list={[code === lang && "font-semibold"]}
              >
                {name}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <button
        id="theme-toggle"
        type="button"
        class="btn btn-ghost btn-square btn-sm focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-2"
        aria-label={t("nav.darkMode")}
        aria-pressed="false"
      >
        <svg aria-hidden="true" class="block size-4 dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9"></path>
        </svg>
        <svg aria-hidden="true" class="hidden size-4 dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>
