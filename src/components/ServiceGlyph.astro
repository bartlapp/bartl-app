---
// SPDX-License-Identifier: Apache-2.0
interface Props { kind: "document" | "key" | "state" | "person" | "application"; x?: number; y?: number; scale?: number }
const { kind, x = 0, y = 0, scale = 1 } = Astro.props;
---
<g transform={`translate(${x} ${y}) scale(${scale})`} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {kind === "document" && <><path d="M0 0h28l12 12v44H0z" fill="var(--color-base-100)"/><path d="M28 0v12h12M9 24h22M9 32h15M9 40h22"/><circle cx="29" cy="32" r="3" fill="currentColor"/></>}
  {kind === "key" && <><circle cx="10" cy="10" r="9"/><path d="m17 17 21 21m-8-8 6-6m-1 11 6-6"/></>}
  {kind === "state" && <><path d="M0 8v34c0 11 40 11 40 0V8" fill="var(--color-base-100)"/><ellipse cx="20" cy="8" rx="20" ry="8"/><path d="M0 25c0 11 40 11 40 0"/><path d="M52 0h20l10 10v42H52z" fill="var(--color-base-100)"/><path d="M72 0v10h10M59 21h16M59 29h10M59 37h16"/><circle cx="76" cy="29" r="2" fill="currentColor"/></>}
  {kind === "person" && <><circle cx="18" cy="12" r="11"/><path d="M0 67V44a18 18 0 0 1 36 0v23M11 49v18M27 49v18M36 47l16-14"/></>}
  {kind === "application" && <><rect width="112" height="90" rx="5" fill="var(--color-base-100)"/><path d="M0 16h112"/><circle cx="9" cy="8" r="1"/><circle cx="16" cy="8" r="1"/><path d="m83 62 16-16 5 5-16 16-8 3zM99 46l-5-5"/></>}
</g>
