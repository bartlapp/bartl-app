---
// SPDX-License-Identifier: Apache-2.0
import contract from "../../README.md?raw";
import type { Lang } from "@/i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
const source = contract.match(new RegExp(`<!-- startup-explanation:${lang} -->\\s*([\\s\\S]*?)\\s*<!-- /startup-explanation:${lang} -->`))?.[1];
if (!source) throw new Error(`Missing canonical startup explanation: ${lang}`);
const blocks = source.split(/\n\s*\n/);
---
<div class="startup-explanation space-y-5 text-lg leading-relaxed">
  {blocks.map(block => block.startsWith("- ") ? (
    <ul class="list-disc space-y-2 pl-6">{block.split("\n").map(line => <li>{line.slice(2)}</li>)}</ul>
  ) : <p>{block}</p>)}
</div>
