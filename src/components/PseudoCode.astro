---
// SPDX-License-Identifier: Apache-2.0
import type { Lang } from "@/i18n/ui";
import { startupCode } from "@/content/startup-code";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const label =
  lang === "de"
    ? "Pseudocode für die Bartl-Startentscheidung"
    : "Pseudocode for the Bartl startup decision";
---

<figure>
  <figcaption class="sr-only">{label}</figcaption>
  <div class="border-code-border shadow-base-content/10 overflow-hidden rounded-lg border shadow-lg">
    <pre class="bg-code-background text-code-foreground overflow-x-auto px-4 py-5 font-mono text-xs leading-loose sm:px-6 sm:text-sm"><code set:html={startupCode.map((line) => line.html).join("\n")} /></pre>
  </div>
</figure>
