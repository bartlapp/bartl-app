---
// SPDX-License-Identifier: Apache-2.0
import { landingCopy } from "@/content/landing";
import type { Lang } from "@/i18n/ui";
import ServiceHomepage from "@/components/ServiceHomepage.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = landingCopy.de;
const approach = `/${lang}/derivation/`;
const implement = `/${lang}/implement/`;
const contract = `/${lang}/spec/`;
---

{lang === "en" ? <ServiceHomepage copy={landingCopy.en} /> : (
<article>
  <header class="border-base-300 border-b">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <h1 class="max-w-4xl text-4xl leading-tight font-medium text-balance sm:text-6xl">{c.title}</h1>
      <p class="mt-8 max-w-3xl text-xl leading-relaxed sm:text-2xl">{c.lead}</p>
      <p class="text-base-content/75 mt-6 max-w-3xl text-lg leading-relaxed">{c.introduction}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={approach} class="btn btn-primary h-auto min-h-12 py-3 text-wrap focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-4">{c.approachLink}</a>
        <a href={implement} class="btn btn-outline h-auto min-h-12 py-3 text-wrap focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-4">{c.implementLink}</a>
      </div>
    </div>
  </header>

  <section aria-labelledby="alternative-title" class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:grid lg:grid-cols-3 lg:gap-12 lg:px-8">
    <h2 id="alternative-title" class="text-3xl leading-tight text-balance">{c.alternative.title}</h2>
    <div class="mt-6 max-w-3xl space-y-5 text-lg leading-relaxed lg:col-span-2 lg:mt-0">
      {c.alternative.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section aria-labelledby="contributions-title" class="bg-base-200/50 border-base-300 border-y">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
      <h2 id="contributions-title" class="max-w-3xl text-3xl leading-tight text-balance sm:text-4xl">{c.contributionsTitle}</h2>
      <div class="mt-10">
        {c.contributions.map((contribution, index) => (
          <section aria-labelledby={`contribution-${index}`} class="border-base-300 border-t py-8 sm:py-10 lg:grid lg:grid-cols-3 lg:gap-12">
            <h3 id={`contribution-${index}`} class="text-xl leading-snug sm:text-2xl">{contribution.title}</h3>
            <div class="text-base-content/80 mt-5 max-w-3xl space-y-4 text-lg leading-relaxed lg:col-span-2 lg:mt-0">
              {contribution.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="maintenance-title" class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:grid lg:grid-cols-3 lg:gap-12 lg:px-8">
    <h2 id="maintenance-title" class="text-3xl leading-tight text-balance">{c.maintenance.title}</h2>
    <div class="mt-6 max-w-3xl space-y-5 text-lg leading-relaxed lg:col-span-2 lg:mt-0">
      {c.maintenance.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section aria-labelledby="example-title" class="bg-base-200/50 border-base-300 border-y">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:grid lg:grid-cols-3 lg:gap-12 lg:px-8">
      <h2 id="example-title" class="text-3xl leading-tight text-balance">{c.example.title}</h2>
      <div class="mt-6 max-w-3xl lg:col-span-2 lg:mt-0">
        <div class="space-y-5 text-lg leading-relaxed">
          {c.example.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <a href={`${implement}#${c.exampleAnchor}`} class="link text-primary mt-8 inline-block text-lg underline-offset-4 focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-4">{c.exampleLink}</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="sustain-title" class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="max-w-3xl">
      <h2 id="sustain-title" class="text-3xl leading-tight text-balance sm:text-4xl">{c.sustain.title}</h2>
      <div class="mt-6 space-y-5 text-lg leading-relaxed">
        {c.sustain.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4">
        <a href={approach} class="link text-primary underline-offset-4 focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-4">{c.philosophyLink}</a>
        <a href={contract} class="link text-primary underline-offset-4 focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-4">{c.contractLink}</a>
      </div>
    </div>
  </section>
</article>
)}
