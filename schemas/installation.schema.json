{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bartl.app/schemas/installation.schema.json",
  "title": "Bartl installation record",
  "description": "Versioned installation-wide identity, resource graph, protected-input references, package placement and typed observations. This schema does not provision resources, derive defaults or validate package-owned service fields. Cross-record reference and provider compatibility checks are separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "customer",
    "installation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "customer": {
      "description": "Stable customer identity in the operator's customer inventory, not a DNS domain or provider-issued ID. Installations of the same customer retain this value; distinguish different customers in that inventory. The operator recipe selects it, not this schema.",
      "examples": ["acme"],
      "$ref": "#/definitions/identifier"
    },
    "installation": {
      "description": "Stable operational and administrative-access boundary within this customer; unique among that customer's installations. The new-installation recipe defaults it to customer (acme), not the schema. Separate it when protected stores and actual access grants must be separate, not for each cluster or application. A separate ID or store alone does not restrict provider credentials.",
      "examples": ["acme", "production"],
      "$ref": "#/definitions/identifier"
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "description": "DNS base domain for application endpoint derivation, not the customer or installation ID. The operator selects an authorized domain; packages derive their own hostnames. DNS names must not collide with other installations using that namespace. This need not equal the provider's delegated zone, and the schema neither derives it nor verifies DNS control.",
          "examples": ["acme.fke.systems"],
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "$ref": "#/definitions/identifier"
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passStore": {
          "description": "Explicit protected store for this installation's administrative-access boundary. Existing references are authoritative; do not fall back to a personal store. Separate stores require correspondingly scoped credentials and access grants to provide isolation.",
          "examples": ["acme-secrets"],
          "type": "string",
          "minLength": 1
        }
      }
    },
    "providers": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/identifier"
      },
      "additionalProperties": {
        "$ref": "#/definitions/provider"
      }
    },
    "networks": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/identifier"
      },
      "additionalProperties": {
        "$ref": "#/definitions/network"
      }
    },
    "vms": {
      "description": "VMs keyed by stable installation-local VM IDs, unique within this map, independent of cluster membership and provider-issued IDs. IDs are not positions and are not renumbered after deletion; recipes select them explicitly.",
      "type": "object",
      "propertyNames": {
        "description": "Installation-local VM map key, such as vm-1. References under clusters.<cluster>.nodes use this key, not configuration.name or observed.server.id.",
        "examples": ["vm-1"],
        "$ref": "#/definitions/identifier"
      },
      "additionalProperties": {
        "$ref": "#/definitions/vm"
      }
    },
    "clusters": {
      "description": "Clusters keyed by stable installation-local cluster IDs, unique within this map. Other installations may reuse cluster-1; the customer/installation pair supplies its wider identity. Recipes select keys explicitly, not this schema.",
      "type": "object",
      "propertyNames": {
        "description": "Installation-local cluster map key, such as cluster-1, not a provider-visible name, kubectl context or provider-issued ID. Retain it across ordinary operation without positional renumbering.",
        "examples": ["cluster-1"],
        "$ref": "#/definitions/identifier"
      },
      "additionalProperties": {
        "$ref": "#/definitions/cluster"
      }
    },
    "packages": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/identifier"
      },
      "additionalProperties": {
        "$ref": "#/definitions/package"
      }
    },
    "services": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/identifier"
      },
      "additionalProperties": {
        "type": "object",
        "description": "Package-owned service configuration, validated by the selected package rather than duplicated centrally."
      }
    },
    "deployments": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/identifier"
      },
      "additionalProperties": {
        "$ref": "#/definitions/deployment"
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deployments": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/identifier"
          },
          "additionalProperties": {
            "$ref": "#/definitions/deploymentOperation"
          }
        },
        "dns": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/definitions/dnsRecord"
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "points": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/definitions/identifier"
              },
              "additionalProperties": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/definitions/identifier"
                },
                "additionalProperties": {
                  "$ref": "#/definitions/recoveryPoint"
                }
              }
            }
          }
        }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      },
      "description": "Package-owned connection sections. Validate their contents through the consuming packages."
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "maxLength": 63
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "ownership": {
      "enum": [
        "managed",
        "external"
      ]
    },
    "credentialRef": {
      "description": "Protected input reference, never a plaintext credential. passEntry is relative to credentials.passStore; file is an independently retained protected file.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passEntry"
          ],
          "properties": {
            "passEntry": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environment"
          ],
          "properties": {
            "environment": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "hetznerId": {
      "description": "Provider-issued Hetzner resource identifier, interpreted with resource type and the selected provider binding/scope. Record the API result; never derive it from a VM/cluster map key or desired name. This is not deletion authorization.",
      "examples": [12345678, "12345678"],
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ipv4": {
      "type": "string",
      "format": "ipv4"
    },
    "ipv6": {
      "type": "string",
      "format": "ipv6"
    },
    "address": {
      "oneOf": [
        {
          "$ref": "#/definitions/ipv4"
        },
        {
          "$ref": "#/definitions/ipv6"
        }
      ]
    },
    "cidr": {
      "type": "string",
      "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$",
      "description": "CIDR text; network-family prefix bounds and host-bit checks require semantic validation."
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "provider": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "scope",
            "credentials"
          ],
          "properties": {
            "type": {
              "const": "hetzner"
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project"
              ],
              "properties": {
                "project": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "credentials": {
              "$ref": "#/definitions/credentialRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "scope",
            "credentials"
          ],
          "properties": {
            "type": {
              "const": "aws"
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "accountId",
                "region"
              ],
              "properties": {
                "accountId": {
                  "type": "string",
                  "pattern": "^[0-9]{12}$"
                },
                "region": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "credentials": {
              "$ref": "#/definitions/credentialRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "scope",
            "credentials"
          ],
          "properties": {
            "type": {
              "const": "desec"
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "zone"
              ],
              "properties": {
                "zone": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "credentials": {
              "$ref": "#/definitions/credentialRef"
            }
          }
        }
      ]
    },
    "hetznerVmConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "serverType",
        "location",
        "image"
      ],
      "properties": {
        "name": {
          "description": "Desired provider-visible server name, distinct from the installation-local VM key and observed.server.id. The Base new-cluster recipe derives <installation>-<cluster> (acme-cluster-1) and retains it; the schema does not derive or enforce naming uniqueness. Avoid collisions in the selected Hetzner project and respect provider naming rules.",
          "examples": ["acme-cluster-1"],
          "type": "string",
          "minLength": 1
        },
        "serverType": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "sshKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "labels": {
          "$ref": "#/definitions/labels"
        },
        "publicIPv4": {
          "type": "boolean"
        },
        "publicIPv6": {
          "type": "boolean"
        }
      }
    },
    "awsVmConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "instanceType",
        "image",
        "availabilityZone"
      ],
      "properties": {
        "name": {
          "description": "Desired provider-visible VM name, not the installation-local VM key or observed.instanceId. Select and retain it according to the operator recipe and the selected AWS account/region's naming policy; a name is not a unique EC2 instance identity. The schema does not derive it.",
          "examples": ["acme-cluster-1"],
          "type": "string",
          "minLength": 1
        },
        "instanceType": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "availabilityZone": {
          "type": "string",
          "minLength": 1
        },
        "sshKeyName": {
          "type": "string",
          "minLength": 1
        },
        "rootVolumeGiB": {
          "type": "integer",
          "minimum": 1
        },
        "publicIPv4": {
          "type": "boolean"
        },
        "tags": {
          "$ref": "#/definitions/labels"
        }
      }
    },
    "hetznerVmObserved": {
      "description": "Provider API observations for this VM under its selected Hetzner binding. Resource IDs and allocated addresses identify actual results, not desired names or installation-local map keys; do not synthesize them from naming conventions.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "description": "Provider-issued server ID in the selected Hetzner project, not vm-1, cluster-1 or acme-cluster-1. Retain the returned identity for reconciliation and live checks.",
              "examples": [12345678],
              "$ref": "#/definitions/hetznerId"
            },
            "name": {
              "description": "Server name observed from the provider, not an identity substitute or a second desired-name input. It may differ from configuration.name.",
              "examples": ["acme-cluster-1"],
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "primaryIPv4": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "ownership"
          ],
          "properties": {
            "id": {
              "description": "Provider-issued Primary IPv4 resource ID, separate from the server ID and its allocated IP address.",
              "$ref": "#/definitions/hetznerId"
            },
            "address": {
              "$ref": "#/definitions/ipv4"
            },
            "ownership": {
              "enum": [
                "managed",
                "external"
              ]
            }
          }
        },
        "primaryIPv6": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "ownership"
          ],
          "properties": {
            "id": {
              "description": "Provider-issued Primary IPv6 resource ID, separate from the server ID and its allocated address/network.",
              "$ref": "#/definitions/hetznerId"
            },
            "address": {
              "$ref": "#/definitions/ipv6"
            },
            "network": {
              "$ref": "#/definitions/cidr"
            },
            "ownership": {
              "enum": [
                "managed",
                "external"
              ]
            }
          }
        },
        "networkAttachments": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/identifier"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "networkId"
            ],
            "properties": {
              "networkId": {
                "description": "Provider-issued network ID, not the installation-local network or attachment map key.",
                "$ref": "#/definitions/hetznerId"
              },
              "address": {
                "$ref": "#/definitions/ipv4"
              }
            }
          }
        }
      }
    },
    "awsVmObserved": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instanceId": {
          "description": "Provider-issued EC2 instance ID in the selected account/region, not the VM map key or desired name.",
          "examples": ["i-0123456789abcdef0"],
          "type": "string",
          "minLength": 1
        },
        "privateIPv4": {
          "$ref": "#/definitions/ipv4"
        },
        "publicIPv4": {
          "$ref": "#/definitions/ipv4"
        },
        "publicIPv6": {
          "$ref": "#/definitions/ipv6"
        },
        "networkInterfaces": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/identifier"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "description": "Provider-issued network-interface ID in the selected account/region, not its installation-local map key.",
                "examples": ["eni-0123456789abcdef0"],
                "type": "string",
                "minLength": 1
              },
              "address": {
                "$ref": "#/definitions/address"
              }
            }
          }
        }
      }
    },
    "vm": {
      "description": "Standalone machine. Provider scope and resource ownership apply to observations; an attached resource has independent ownership where stated.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "ownership",
            "configuration"
          ],
          "properties": {
            "provider": {
              "$ref": "#/definitions/identifier"
            },
            "ownership": {
              "enum": [
                "managed",
                "external"
              ]
            },
            "networkAttachments": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/definitions/identifier"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "network",
                  "subnet"
                ],
                "properties": {
                  "network": {
                    "$ref": "#/definitions/identifier"
                  },
                  "subnet": {
                    "$ref": "#/definitions/identifier"
                  },
                  "address": {
                    "$ref": "#/definitions/address"
                  }
                }
              }
            },
            "configuration": {
              "$ref": "#/definitions/hetznerVmConfiguration"
            },
            "observed": {
              "$ref": "#/definitions/hetznerVmObserved"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "ownership",
            "configuration"
          ],
          "properties": {
            "provider": {
              "$ref": "#/definitions/identifier"
            },
            "ownership": {
              "enum": [
                "managed",
                "external"
              ]
            },
            "networkAttachments": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/definitions/identifier"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "network",
                  "subnet"
                ],
                "properties": {
                  "network": {
                    "$ref": "#/definitions/identifier"
                  },
                  "subnet": {
                    "$ref": "#/definitions/identifier"
                  },
                  "address": {
                    "$ref": "#/definitions/address"
                  }
                }
              }
            },
            "configuration": {
              "$ref": "#/definitions/awsVmConfiguration"
            },
            "observed": {
              "$ref": "#/definitions/awsVmObserved"
            }
          }
        }
      ]
    },
    "hetznerSubnet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cidr",
        "configuration"
      ],
      "properties": {
        "cidr": {
          "$ref": "#/definitions/cidr"
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "networkZone",
            "type"
          ],
          "properties": {
            "networkZone": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "cloud"
            }
          }
        }
      }
    },
    "awsSubnet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cidr",
        "configuration"
      ],
      "properties": {
        "cidr": {
          "$ref": "#/definitions/cidr"
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availabilityZone"
          ],
          "properties": {
            "availabilityZone": {
              "type": "string",
              "minLength": 1
            },
            "assignPublicIPv4": {
              "type": "boolean"
            }
          }
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "network": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "ownership",
            "configuration",
            "subnets"
          ],
          "properties": {
            "provider": {
              "$ref": "#/definitions/identifier"
            },
            "ownership": {
              "enum": [
                "managed",
                "external"
              ]
            },
            "configuration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "cidr"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "cidr": {
                  "$ref": "#/definitions/cidr"
                },
                "labels": {
                  "$ref": "#/definitions/labels"
                }
              }
            },
            "subnets": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/definitions/identifier"
              },
              "additionalProperties": {
                "$ref": "#/definitions/hetznerSubnet"
              },
              "minProperties": 1
            },
            "observed": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "$ref": "#/definitions/hetznerId"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "ownership",
            "configuration",
            "subnets"
          ],
          "properties": {
            "provider": {
              "$ref": "#/definitions/identifier"
            },
            "ownership": {
              "enum": [
                "managed",
                "external"
              ]
            },
            "configuration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "cidr"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "cidr": {
                  "$ref": "#/definitions/cidr"
                },
                "enableDnsSupport": {
                  "type": "boolean"
                },
                "enableDnsHostnames": {
                  "type": "boolean"
                },
                "tags": {
                  "$ref": "#/definitions/labels"
                }
              }
            },
            "subnets": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/definitions/identifier"
              },
              "additionalProperties": {
                "$ref": "#/definitions/awsSubnet"
              },
              "minProperties": 1
            },
            "observed": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    },
    "kubeconfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context"
      ],
      "properties": {
        "context": {
          "description": "Retained kubectl context name; must distinguish clusters in the operator's kubeconfig inventory. For a new cluster the Base recipe derives <customer>-<installation>-<cluster>, giving acme-acme-cluster-1 for acme/acme/cluster-1. The schema performs no derivation or uniqueness check. Read an existing name unchanged on resumption; it is neither a provider name nor a provider-issued ID.",
          "examples": ["acme-acme-cluster-1", "acme-production-cluster-1"],
          "type": "string",
          "minLength": 1
        },
        "credential": {
          "$ref": "#/definitions/credentialRef"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "caSha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "firewall": {
      "description": "Independently scoped firewall identity. Reference or attachment never grants permission to modify or delete an external resource.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "provider",
            "ownership",
            "id"
          ],
          "properties": {
            "type": {
              "const": "hetzner"
            },
            "provider": {
              "$ref": "#/definitions/identifier"
            },
            "ownership": {
              "enum": [
                "managed",
                "external"
              ]
            },
            "id": {
              "description": "Provider-issued Hetzner firewall ID in this firewall's provider binding, not its installation-local observation key or display name.",
              "examples": [23456789],
              "$ref": "#/definitions/hetznerId"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "attachedVms": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/identifier"
              },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "provider",
            "ownership",
            "id"
          ],
          "properties": {
            "type": {
              "const": "aws-security-group"
            },
            "provider": {
              "$ref": "#/definitions/identifier"
            },
            "ownership": {
              "enum": [
                "managed",
                "external"
              ]
            },
            "id": {
              "description": "Provider-issued AWS security-group ID in this firewall's account/region, not its installation-local observation key or display name.",
              "examples": ["sg-0123456789abcdef0"],
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "attachedVms": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/identifier"
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "k3sConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution"
      ],
      "properties": {
        "distribution": {
          "const": "k3s"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "clusterCIDR": {
          "$ref": "#/definitions/cidr"
        },
        "serviceCIDR": {
          "$ref": "#/definitions/cidr"
        },
        "clusterDNS": {
          "$ref": "#/definitions/address"
        },
        "disable": {
          "type": "array",
          "items": {
            "enum": [
              "traefik",
              "servicelb",
              "local-storage",
              "metrics-server"
            ]
          },
          "uniqueItems": true
        },
        "tlsSANs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "enum": [
            "server",
            "agent"
          ]
        }
      }
    },
    "eksConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "name",
        "version",
        "roleArn",
        "network",
        "subnets"
      ],
      "properties": {
        "service": {
          "const": "eks"
        },
        "name": {
          "description": "Desired provider-visible EKS cluster name, distinct from the installation-local cluster key and observed provider identifiers. Select a name unique within the AWS account/region and retain it; the schema does not derive it or verify provider naming rules.",
          "examples": ["acme-cluster-1"],
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "roleArn": {
          "type": "string",
          "minLength": 1
        },
        "network": {
          "$ref": "#/definitions/identifier"
        },
        "subnets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/identifier"
          },
          "uniqueItems": true,
          "minItems": 2
        },
        "endpointPublicAccess": {
          "type": "boolean"
        },
        "endpointPrivateAccess": {
          "type": "boolean"
        },
        "publicAccessCidrs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cidr"
          },
          "uniqueItems": true
        }
      }
    },
    "cluster": {
      "description": "Self-managed nodes reference standalone VMs; provider-managed EKS describes an explicit provider service, not a supported provisioning procedure.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "management",
            "ownership",
            "nodes",
            "configuration"
          ],
          "properties": {
            "management": {
              "const": "self-managed"
            },
            "ownership": {
              "enum": [
                "managed",
                "external"
              ]
            },
            "nodes": {
              "description": "Membership keyed by references to installation-local vms map keys, such as vm-1, not provider server IDs or names. Membership does not transfer resource ownership.",
              "type": "object",
              "propertyNames": {
                "$ref": "#/definitions/identifier"
              },
              "additionalProperties": {
                "$ref": "#/definitions/node"
              },
              "minProperties": 1
            },
            "configuration": {
              "$ref": "#/definitions/k3sConfiguration"
            },
            "kubeconfig": {
              "$ref": "#/definitions/kubeconfig"
            },
            "observed": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "api": {
                  "$ref": "#/definitions/api"
                },
                "firewalls": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/definitions/identifier"
                  },
                  "additionalProperties": {
                    "$ref": "#/definitions/firewall"
                  }
                },
                "kubeSystemUid": {
                  "description": "Observed Kubernetes UID of the kube-system namespace, used to distinguish actual cluster incarnations. Kubernetes issues it; neither the cluster key nor its kubectl context derives it.",
                  "examples": ["12345678-1234-4234-8234-123456789abc"],
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "management",
            "provider",
            "ownership",
            "configuration"
          ],
          "properties": {
            "management": {
              "const": "provider-managed"
            },
            "provider": {
              "$ref": "#/definitions/identifier"
            },
            "ownership": {
              "enum": [
                "managed",
                "external"
              ]
            },
            "configuration": {
              "$ref": "#/definitions/eksConfiguration"
            },
            "kubeconfig": {
              "$ref": "#/definitions/kubeconfig"
            },
            "observed": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "description": "Provider-reported managed-cluster identifier under the selected provider binding; not the installation-local cluster key or kubectl context. Retain the provider's returned value, even if it uses the configured name.",
                  "type": "string",
                  "minLength": 1
                },
                "arn": {
                  "description": "Provider-issued EKS ARN, identifying the managed cluster with account and region. Record the provider result rather than constructing it from the installation-local cluster key.",
                  "examples": ["arn:aws:eks:eu-central-1:123456789012:cluster/acme-cluster-1"],
                  "type": "string",
                  "minLength": 1
                },
                "api": {
                  "$ref": "#/definitions/api"
                },
                "firewalls": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/definitions/identifier"
                  },
                  "additionalProperties": {
                    "$ref": "#/definitions/firewall"
                  }
                },
                "kubeSystemUid": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "chart"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "chart": {
          "type": "string",
          "pattern": "^(oci://|https://)"
        },
        "chartSha256": {
          "$ref": "#/definitions/sha256"
        },
        "images": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/identifier"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "digest"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance",
        "cluster",
        "namespace",
        "release",
        "package"
      ],
      "properties": {
        "instance": {
          "$ref": "#/definitions/identifier"
        },
        "cluster": {
          "$ref": "#/definitions/identifier"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "release": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 53
        },
        "package": {
          "$ref": "#/definitions/identifier"
        }
      }
    },
    "deploymentOperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "replicas": {
          "description": "Legacy package-owned override for packages that still consume it. Forbidden for Keycloak, whose live replica authority is its application CR.",
          "type": "integer",
          "minimum": 0
        },
        "ingressEnabled": {
          "type": "boolean"
        },
        "maintenance": {
          "type": "boolean"
        },
        "backupSuspend": {
          "type": "boolean"
        }
      }
    },
    "recoveryPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment",
        "snapshot"
      ],
      "properties": {
        "deployment": {
          "$ref": "#/definitions/identifier"
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dnsRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "address",
        "ttl"
      ],
      "properties": {
        "type": {
          "enum": [
            "A",
            "AAAA",
            "CNAME",
            "TXT"
          ]
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "ttl": {
          "type": "integer",
          "minimum": 1
        },
        "provider": {
          "$ref": "#/definitions/identifier"
        },
        "ownership": {
          "enum": [
            "managed",
            "external"
          ]
        }
      }
    }
  }
}
